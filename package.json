{
  "name": "bo-grid",
  "version": "2.10.0",
  "type": "module",
  "license": "MIT",
  "description": "Tiny, fast Svelte 5 data grid for trading screens: batched realtime cell updates, virtual scrolling, grouping, pivot, tree data and canvas sparklines, MIT licensed.",
  "homepage": "https://bonguynvan.github.io/bo-grid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonguynvan/bo-grid.git"
  },
  "bugs": {
    "url": "https://github.com/bonguynvan/bo-grid/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bonguynvan"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "datagrid",
    "grid",
    "table",
    "sparkline",
    "candlestick",
    "virtual-scroll",
    "realtime",
    "fintech",
    "trading",
    "market-data",
    "order-book",
    "websocket",
    "vietnam-stock-exchange",
    "price-limit",
    "data-grid",
    "datatable",
    "data-table",
    "spreadsheet",
    "pivot-table",
    "tree-grid",
    "svelte-component",
    "web-component",
    "price-board",
    "virtualization",
    "accessibility"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "svelte": "./dist/realtime/index.js",
      "default": "./dist/realtime/index.js"
    },
    "./trading": {
      "types": "./dist/trading/index.d.ts",
      "svelte": "./dist/trading/index.js",
      "default": "./dist/trading/index.js"
    },
    "./ladder": {
      "types": "./dist/ladder/index.d.ts",
      "svelte": "./dist/ladder/index.js",
      "default": "./dist/ladder/index.js"
    },
    "./element": {
      "types": "./dist/bo-grid.element.d.ts",
      "default": "./dist/bo-grid.element.js"
    },
    "./react": {
      "types": "./dist/bo-grid.react.d.ts",
      "default": "./dist/bo-grid.react.js"
    },
    "./vue": {
      "types": "./dist/bo-grid.vue.d.ts",
      "default": "./dist/bo-grid.vue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/bo-grid.element*.js"
  ],
  "peerDependencies": {
    "react": ">=18",
    "svelte": "^5.0.0",
    "vue": "^3.3.0",
    "xlsx": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "demo:build": "vite build",
    "pages:build": "vite build --base=/bo-grid/ --outDir demo-dist && pnpm site:build && node scripts/site-assets.mjs",
    "preview": "vite preview",
    "site:api": "node scripts/api-manifest.mjs",
    "site:dev": "node scripts/api-manifest.mjs && cd site && vite dev",
    "site:build": "node scripts/api-manifest.mjs && cd site && vite build",
    "site:check": "node scripts/api-manifest.mjs && node scripts/docs-code.mjs && cd site && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "package": "svelte-package -i src/lib -o dist && node scripts/clean-dist.mjs && pnpm run build:wc && node scripts/emit-element-dts.mjs",
    "build:wc": "vite build --config vite.wc.config.ts && vite build --config vite.wrappers.config.ts",
    "prepublishOnly": "pnpm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
    "size": "vite build && node scripts/size-check.mjs",
    "size:lib": "vite build --config vite.lib.config.ts && node scripts/size-lib.mjs",
    "smoke": "vite build --base=./ --outDir demo-dist && node scripts/smoke.mjs",
    "smoke:wc": "node scripts/wc-smoke.mjs && tsc -p scripts/wrapper-types/tsconfig.json",
    "check:examples": "node scripts/check-examples.mjs",
    "ssr": "node scripts/ssr.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:browser": "vite build --base=./ --outDir demo-dist && node scripts/bench-browser.mjs --dir demo-dist",
    "bench:feed": "vite build --config vite.lib.config.ts && node scripts/bench-feed.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.8",
    "pkg-pr-new": "^0.0.91",
    "puppeteer-core": "^24.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.44",
    "xlsx": "0.18.5"
  }
}
